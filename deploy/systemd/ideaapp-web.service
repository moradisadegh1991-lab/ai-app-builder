[Unit]
Description=IdeaApp Builder web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ideaapp
Group=ideaapp
WorkingDirectory=/opt/ideaapp/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3310
EnvironmentFile=/etc/ideaapp/web.env
ExecStart=/usr/bin/node /opt/ideaapp/current/.next/standalone/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
