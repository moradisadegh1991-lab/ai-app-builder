diff --git a/src/lib/ai/arvan-catalog.ts b/src/lib/ai/arvan-catalog.ts
new file mode 100644
index 0000000..0762db9
--- /dev/null
+++ b/src/lib/ai/arvan-catalog.ts
@@ -0,0 +1,97 @@
+import { sql } from "drizzle-orm";
+import { z } from "zod";
+import { env } from "../env";
+import { HttpError } from "../http";
+import { queryRows } from "../workflows/sql";
+import { arvanReferenceRate, arvanDefaultModels } from "./arvan-reference";
+import { estimateToman } from "./cost-estimate";
+
+export const arvanRoles = ["architect", "designer", "frontend", "backend", "reviewer", "debugger"] as const;
+export const arvanTiers = ["economy", "standard"] as const;
+const modelId = z.string().trim().regex(/^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,149}$/);
+const rate = z.number().int().positive().max(1e12);
+const modelFields = z.object({
+  id: modelId,
+  label: z.string().trim().min(1).max(120),
+  inputTomanPerMillion: rate,
+  outputTomanPerMillion: rate,
+  responseId: modelId.nullable(),
+  enabled: z.boolean(),
+});
+const storedModel = modelFields.extend({ updatedAt: z.iso.datetime({ offset: true }) });
+const routeFields = z.object({
+  role: z.enum(arvanRoles), tier: z.enum(arvanTiers), primary: modelId, fallback: modelId.nullable(),
+});
+export const arvanCatalogChange = z.discriminatedUnion("type", [
+  modelFields.extend({ type: z.literal("model") }),
+  routeFields.extend({ type: z.literal("route") }),
+]);
+export type ArvanCatalogChange = z.infer<typeof arvanCatalogChange>;
+export type ArvanModel = z.infer<typeof storedModel> & { source: "public-reference" | "administrator" };
+export type ArvanRoute = z.infer<typeof routeFields>;
+
+export function arvanCatalog(rows: { key: string; value: unknown }[]) {
+  const models = new Map<string, ArvanModel>();
+  const routes = new Map<string, ArvanRoute>();
+  for (const id of new Set(Object.values(arvanDefaultModels))) {
+    const tariff = arvanReferenceRate(id)!;
+    models.set(id, { id, label: id, enabled: true, responseId: id === "Kimi-K2.6" ? "moonshotai/kimi-k2.6" : null, ...tariff });
+  }
+  for (const row of rows) {
+    if (row.key.startsWith("model:")) {
+      const id = row.key.slice(6);
+      const parsed = storedModel.safeParse(row.value);
+      if (parsed.success && parsed.data.id === id) models.set(id, { ...parsed.data, source: "administrator" });
+      else models.delete(id);
+    } else {
+      const parsed = routeFields.safeParse(row.value);
+      if (parsed.success && row.key === `route:${parsed.data.role}:${parsed.data.tier}`)
+        routes.set(`${parsed.data.role}:${parsed.data.tier}`, parsed.data);
+    }
+  }
+  return { models, routes };
+}
+
+export async function getArvanCatalog() {
+  return arvanCatalog(await queryRows<{ key: string; value: unknown }>(sql`select key,value from arvan_catalog_settings`));
+}
+
+export function activeArvanModel(catalog: ReturnType<typeof arvanCatalog>, id: string) {
+  const model = catalog.models.get(id);
+  return model?.enabled && estimateToman(model, 1, 1) !== null ? model : null;
+}
+
+export async function saveArvanCatalog(change: ArvanCatalogChange) {
+  const { type, ...data } = change;
+  const key = change.type === "model" ? `model:${change.id}` : `route:${change.role}:${change.tier}`;
+  if (change.type === "route") {
+    const catalog = await getArvanCatalog();
+    if (change.primary === change.fallback || !activeArvanModel(catalog, change.primary) ||
+      (change.fallback && !activeArvanModel(catalog, change.fallback))) {
+      throw new HttpError(400, "برای مدل اصلی و جایگزین، مدل‌های فعال و متفاوت با تعرفهٔ معتبر انتخاب کنید.");
+    }
+  }
+  const value = type === "model" ? { ...data, updatedAt: new Date().toISOString() } : data;
+  await queryRows(sql`insert into arvan_catalog_settings (key,value) values(${key},${JSON.stringify(value)}::jsonb)
+    on conflict(key) do update set value=excluded.value returning key`);
+}
+
+export async function discoverArvanModels(): Promise<{ status: "ok" | "unavailable"; ids: string[] }> {
+  const key = env.aiGatewayKey();
+  if (!key || process.env.AI_GATEWAY_KIND !== "arvan" || env.aiGatewayBaseUrl() !== "https://api.arvancloudai.ir/v1")
+    return { status: "unavailable", ids: [] };
+  try {
+    const response = await fetch("https://api.arvancloudai.ir/v1/models", {
+      headers: { Authorization: `apikey ${key.replace(/^apikey\s+/i, "")}` },
+      signal: AbortSignal.timeout(8000), cache: "no-store", redirect: "error",
+    });
+    if (!response.ok) return { status: "unavailable", ids: [] };
+    const text = await response.text();
+    if (text.length > 1_000_000) return { status: "unavailable", ids: [] };
+    const body = z.object({ data: z.array(z.object({ id: modelId })).max(3000) }).safeParse(JSON.parse(text));
+    if (!body.success) return { status: "unavailable", ids: [] };
+    return { status: "ok", ids: [...new Set(body.data.data.map(({ id }) => id))].sort() };
+  } catch {
+    return { status: "unavailable", ids: [] };
+  }
+}
