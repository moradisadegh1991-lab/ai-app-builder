+import { notFound } from "next/navigation";
+import { Header } from "@/components/Header";
+import { ArvanCatalogPanel } from "@/components/ArvanCatalogPanel";
+import { arvanRoles, getArvanCatalog } from "@/lib/ai/arvan-catalog";
+import { arvanDefaultModels, arvanReference } from "@/lib/ai/arvan-reference";
+import { isQuotaAdmin } from "@/lib/billing/ai-quotas";
+import { requirePageUser } from "@/lib/session";
+
+export default async function ArvanModelsPage() {
+  const user = await requirePageUser();
+  if (!isQuotaAdmin(user)) notFound();
+  const { models, routes } = await getArvanCatalog();
+  return <>
+    <Header user={user} />
+    <main className="page-container space-y-5 py-8">
+      <h1 className="text-2xl font-bold">مدل‌های آروان</h1>
+      <ArvanCatalogPanel initial={{ models: [...models.values()], routes: [...routes.values()] }}
+        roles={arvanRoles} defaults={arvanDefaultModels} reference={arvanReference.models} />
+    </main>
+  </>;
+}
