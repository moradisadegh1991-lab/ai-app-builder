@@ -0,0 +1,26 @@
+import { arvanCatalogChange, discoverArvanModels, getArvanCatalog, saveArvanCatalog } from "@/lib/ai/arvan-catalog";
+import { isQuotaAdmin } from "@/lib/billing/ai-quotas";
+import { handleRoute, HttpError, readJson } from "@/lib/http";
+import { requireApiUser } from "@/lib/session";
+
+async function authorize() {
+  if (!isQuotaAdmin(await requireApiUser())) throw new HttpError(403, "دسترسی مدیریت مدل برای این حساب فعال نیست.");
+}
+
+export async function GET(request: Request) {
+  return handleRoute(async () => {
+    await authorize();
+    const data = new URL(request.url).searchParams.has("discover")
+      ? await discoverArvanModels()
+      : await getArvanCatalog().then(({ models, routes }) => ({ models: [...models.values()], routes: [...routes.values()] }));
+    return Response.json(data, { headers: { "Cache-Control": "private, no-store" } });
+  });
+}
+
+export async function PATCH(request: Request) {
+  return handleRoute(async () => {
+    await authorize();
+    await saveArvanCatalog(await readJson(request, arvanCatalogChange.parse));
+    return Response.json({ ok: true });
+  });
+}
