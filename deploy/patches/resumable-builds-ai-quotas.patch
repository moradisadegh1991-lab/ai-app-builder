diff --git a/src/lib/billing/ai-quotas.ts b/src/lib/billing/ai-quotas.ts
new file mode 100644
index 0000000..85c7502
--- /dev/null
+++ b/src/lib/billing/ai-quotas.ts
@@ -0,0 +1,55 @@
+import { sql } from "drizzle-orm";
+import { z } from "zod";
+import type { User } from "../db/schema";
+import { env } from "../env";
+import { queryRows } from "../workflows/sql";
+
+export function isQuotaAdmin(user: Pick<User, "githubId">) {
+  return user.githubId !== null && env.developerGithubIds().includes(String(user.githubId));
+}
+
+const tokenLimit = z.number().int().min(0).max(2_000_000_000).nullable();
+export const quotaChange = z.discriminatedUnion("type", [
+  z.object({ type: z.literal("default"), model: z.string().trim().toLowerCase().regex(/^(\*|[a-z0-9][a-z0-9._:/-]{0,149})$/), limit: tokenLimit }),
+  z.object({ type: z.literal("user"), userId: z.uuid(), limit: tokenLimit }),
+]);
+
+export async function quotaSettings(search: string, page: number) {
+  const [defaults, users] = await Promise.all([
+    queryRows<{ model: string; limit: number }>(sql`select model,token_limit as limit from ai_quota_defaults order by model`),
+    queryRows<{ id: string; email: string; name: string | null; limit: number | null; used: string }>(sql`
+      with selected as (
+        select id,email,name from users where ${search}='' or strpos(lower(email),lower(${search}))>0
+          or strpos(lower(coalesce(name,'')),lower(${search}))>0 order by email,id limit 26 offset ${page * 25}
+      )
+      select s.id,s.email,s.name,q.token_limit as limit,
+        ((select coalesce(sum(input_tokens::bigint+output_tokens),0) from usage_records
+          where user_id=s.id and used_platform_key and created_at>=now()-interval '30 days')
+        +(select coalesce(sum(tokens),0) from usage_reservations
+          where user_id=s.id and used_platform_key and state='held' and created_at>=now()-interval '30 days'))::text as used
+      from selected s left join ai_user_quotas q on q.user_id=s.id order by s.email,s.id`),
+  ]);
+  return { defaults, users: users.slice(0, 25), more: users.length > 25 };
+}
+
+export async function saveQuota(change: z.infer<typeof quotaChange>) {
+  // Share the financial admission lock so a change and the next admission have a defined order.
+  const guard = sql`with guard as (select pg_advisory_xact_lock(19871205))`;
+  if (change.type === "user") {
+    if (change.limit === null) {
+      await queryRows(sql`${guard} delete from ai_user_quotas q using guard where q.user_id=${change.userId}::uuid returning q.user_id`);
+      return true;
+    }
+    const rows = await queryRows(sql`${guard} insert into ai_user_quotas(user_id,token_limit)
+      select u.id,${change.limit} from users u,guard where u.id=${change.userId}::uuid
+      on conflict(user_id) do update set token_limit=excluded.token_limit returning user_id`);
+    return rows.length > 0;
+  }
+  if (change.limit === null) {
+    await queryRows(sql`${guard} delete from ai_quota_defaults q using guard where q.model=${change.model} returning q.model`);
+  } else {
+    await queryRows(sql`${guard} insert into ai_quota_defaults(model,token_limit) select ${change.model},${change.limit} from guard
+      on conflict(model) do update set token_limit=excluded.token_limit returning model`);
+  }
+  return true;
+}
