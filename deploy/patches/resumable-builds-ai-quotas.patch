@@ -0,0 +1,27 @@
+import { z } from "zod";
+import { isQuotaAdmin, quotaChange, quotaSettings, saveQuota } from "@/lib/billing/ai-quotas";
+import { handleRoute, HttpError, readJson } from "@/lib/http";
+import { requireApiUser } from "@/lib/session";
+
+async function authorize() {
+  if (!isQuotaAdmin(await requireApiUser())) throw new HttpError(403, "دسترسی مدیریت سهمیه برای این حساب فعال نیست.");
+}
+
+export async function GET(request: Request) {
+  return handleRoute(async () => {
+    await authorize();
+    const params = new URL(request.url).searchParams;
+    const page = z.coerce.number().int().min(0).max(10000).parse(params.get("page") ?? 0);
+    const search = z.string().trim().max(100).parse(params.get("q") ?? "");
+    return Response.json(await quotaSettings(search, page), { headers: { "Cache-Control": "private, no-store" } });
+  });
+}
+
+export async function PATCH(request: Request) {
+  return handleRoute(async () => {
+    await authorize();
+    const change = await readJson(request, quotaChange.parse);
+    if (!(await saveQuota(change))) throw new HttpError(404, "کاربر پیدا نشد.");
+    return Response.json({ ok: true });
+  });
+}
