+import { CompletionTruncatedError } from "../ai/errors";
+
+export const quotaFailureMessages: Record<string, string> = {
+  user_tokens: "سقف توکن ۳۰ روزهٔ حساب پر شده است. پس از آزاد شدن سهمیه یا تغییر آن در پنل، همین مرحله را ادامه دهید.",
+  model_tokens: "سقف توکن ۳۰ روزهٔ این مدل پر شده است. پس از آزاد شدن سهمیه یا تغییر آن در پنل، همین مرحله را ادامه دهید.",
+  uncertain_usage: "مصرف بعضی درخواست‌های سابق هنوز قابل محاسبه نیست. پس از بررسی مصرف سرویس، ساخت را از همین مرحله ادامه دهید.",
+  platform_day: "بودجهٔ ۲۴ ساعتهٔ پلتفرم برای رزرو این مرحله کافی نیست. پس از آزاد شدن بودجه می‌توانید از همین مرحله ادامه دهید.",
+  platform_month: "بودجهٔ ۳۰ روزهٔ پلتفرم برای رزرو این مرحله کافی نیست. پس از آزاد شدن بودجه می‌توانید از همین مرحله ادامه دهید.",
+  user_day: "بودجهٔ ۲۴ ساعتهٔ حساب برای این مرحله کافی نیست.",
+  user_month: "بودجهٔ ۳۰ روزهٔ حساب برای این مرحله کافی نیست.",
+  project_day: "بودجهٔ ۲۴ ساعتهٔ پروژه برای این مرحله کافی نیست.",
+  project_month: "بودجهٔ ۳۰ روزهٔ پروژه برای این مرحله کافی نیست.",
+  run: "بودجهٔ مالی این اجرا برای رزرو مرحلهٔ بعدی کافی نیست.",
+  plan_tokens: "سقف توکن طرح یا این اجرا برای رزرو مرحلهٔ بعدی کافی نیست.",
+};
+
+
+export const workflowMessages = {
+  rate: "ارائه‌دهندهٔ هوش مصنوعی موقتاً تعداد درخواست‌ها را محدود کرده است. مرحله‌های کامل‌شده ذخیره‌اند؛ کمی بعد ادامه دهید.",
+  timeout: "پاسخ سرویس در زمان مقرر نرسید. مصرف این درخواست ممکن است هنوز در حال ثبت باشد؛ پس از بررسی مصرف می‌توانید از همین مرحله ادامه دهید.",
+  unavailable: "سرویس هوش مصنوعی یا ابزار ساخت موقتاً در دسترس نبود. وضعیت سرویس را بررسی کنید و از همین مرحله ادامه دهید.",
+  sandbox: "محیط بررسی و ساخت آماده نبود. پس از رفع مشکل محیط، ساخت را از همان مرحله ادامه دهید.",
+  invalidOutput: "خروجی مدل کامل یا قابل استفاده نبود. از همین مرحله ادامه دهید یا مدل را بررسی کنید.",
+  version: "نسخهٔ پروژه بعد از ثبت اجرا تغییر کرده است. ساخت را با نسخهٔ فعلی شروع کنید.",
+  generic: "این مرحله کامل نشد. نتیجهٔ مراحل موفق ذخیره شده است. از دکمهٔ ادامه استفاده کنید؛ اگر مشکل تکرار شد، شناسهٔ اجرا را برای پشتیبانی بفرستید.",
+} as const;
+
+export function describeWorkflowFailure(error: unknown) {
+  const message = error instanceof Error ? error.message : String(error ?? "");
+  if (/^AI provider error 429:/.test(message)) return { message: workflowMessages.rate, autoRetry: true };
+  if (error instanceof CompletionTruncatedError || /invalid JSON|JSON.*schema|JSON معتبر نبود|پاسخ.*کامل نشد/i.test(message))
+    return { message: workflowMessages.invalidOutput, autoRetry: false };
+  if (/timeout|timed out|زمان مقرر/i.test(message)) return { message: workflowMessages.timeout, autoRetry: false };
+  if (/^AI provider error 5\d\d:|fetch failed|ECONNRESET|^Model unavailable$/i.test(message))
+    return { message: workflowMessages.unavailable, autoRetry: false };
+  if (/^ابزار ارزیابی در دسترس نیست/.test(message)) return { message: workflowMessages.sandbox, autoRetry: false };
+  if (/^نسخه پروژه پس از ورود به صف تغییر کرده/.test(message)) return { message: workflowMessages.version, autoRetry: false };
+  // Only stable server-authored text is allowed here. Provider responses can contain arbitrary data.
+  if (/^(سقف مصرف (۵ ساعته|هفتگی) طرح|سقف توکن ۳۰ روزهٔ (حساب|این مدل) پر شده است\.|بودجهٔ پلتفرم یا سهمیهٔ این اجرا کافی نیست، یا مصرف قبلی نیاز به بررسی دارد\.|سقف توکن این اجرا کافی نیست\.|اعتبار سرویس هوش مصنوعی برای مدل انتخاب‌شده کافی نیست\.|قیمت معتبر این مدل در دسترس نیست؛|درگاه آروان به‌درستی تنظیم نشده است\.|سقف هزینهٔ سرویس تنظیم نشده است؛|بودجهٔ باقی‌مانده کافی نیست یا مصرف قبلی نیاز به بررسی دارد\.)/.test(message)) {
+    return { message: message.split(/\n/, 1)[0]!, autoRetry: false };
+  }
+  if (/^AI provider error (401|403):/.test(message))
+    return { message: "ارائه‌دهنده دسترسی این کلید یا مدل را رد کرد. تنظیمات اتصال را بررسی کنید و سپس همین مرحله را ادامه دهید.", autoRetry: false };
+  if ([...Object.values(workflowMessages), ...Object.values(quotaFailureMessages)].includes(message)) return { message, autoRetry: false };
+  return { message: workflowMessages.generic, autoRetry: false };
+}
