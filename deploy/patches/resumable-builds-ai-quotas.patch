new file mode 100644
index 0000000..37c3396
--- /dev/null
+++ b/drizzle/0013_ai_quota_recovery.sql
@@ -0,0 +1,110 @@
+CREATE TABLE ai_quota_defaults (
+  model text PRIMARY KEY,
+  token_limit integer NOT NULL CHECK (token_limit >= 0)
+);
+CREATE TABLE ai_user_quotas (
+  user_id uuid PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
+  token_limit integer NOT NULL CHECK (token_limit >= 0)
+);
+ALTER TABLE usage_reservations ADD COLUMN requested_model text;
+ALTER TABLE usage_reservations ADD COLUMN task_key text;
+ALTER TABLE workflow_runs ADD COLUMN retry_after timestamptz;
+--> statement-breakpoint
+CREATE FUNCTION admit_ai_request(
+  p_id uuid, p_user uuid, p_project uuid, p_run uuid, p_tokens integer,
+  p_window bigint, p_week bigint, p_amount bigint, p_limits jsonb, p_model text,
+  p_task text, p_developer boolean
+) RETURNS text LANGUAGE plpgsql AS $$
+DECLARE
+  total_limit integer;
+  model_limit integer;
+  total_used bigint;
+  model_used bigint;
+  bucket record;
+  used_toman bigint;
+BEGIN
+  IF p_amount IS NULL OR p_amount < 1 OR p_tokens < 1 THEN RETURN 'configuration'; END IF;
+  PERFORM pg_advisory_xact_lock(19871205);
+  PERFORM id FROM users WHERE id=p_user FOR UPDATE;
+  IF NOT FOUND THEN RETURN 'ownership'; END IF;
+  IF p_project IS NOT NULL AND NOT EXISTS (SELECT 1 FROM projects WHERE id=p_project AND user_id=p_user) THEN RETURN 'ownership'; END IF;
+  IF p_run IS NOT NULL AND NOT EXISTS (
+    SELECT 1 FROM workflow_runs WHERE id=p_run AND user_id=p_user AND status='running'
+      AND (p_project IS NULL OR project_id=p_project) AND lease_expires_at>now()
+  ) THEN RETURN 'ownership'; END IF;
+
+  IF p_developer THEN
+    -- Developer access changes admission only. It does not erase or discount spending.
+    INSERT INTO usage_reservations(id,user_id,project_id,run_id,tokens,used_platform_key,reserved_toman,requested_model,task_key)
+      VALUES(p_id,p_user,p_project,p_run,p_tokens,true,p_amount,p_model,p_task);
+    RETURN 'allowed';
+  END IF;
+
+  SELECT coalesce(
+    (SELECT token_limit FROM ai_user_quotas WHERE user_id=p_user),
+    (SELECT token_limit FROM ai_quota_defaults WHERE model='*')
+  ) INTO total_limit;
+  SELECT token_limit INTO model_limit FROM ai_quota_defaults WHERE model=p_model;
+  IF total_limit IS NOT NULL OR model_limit IS NOT NULL THEN
+    SELECT coalesce(sum(amount),0), coalesce(sum(amount) FILTER (WHERE model=p_model),0)
+      INTO total_used, model_used
+    FROM (
+      SELECT u.input_tokens::bigint+u.output_tokens AS amount,
+        coalesce(r.requested_model, CASE WHEN lower(u.model)='moonshotai/kimi-k2.6' THEN 'kimi-k2.6' ELSE lower(u.model) END) AS model
+      FROM usage_records u LEFT JOIN usage_reservations r ON r.id=u.reservation_id
+      WHERE u.user_id=p_user AND u.used_platform_key AND u.created_at>=now()-interval '30 days'
+      UNION ALL
+      SELECT tokens,requested_model FROM usage_reservations
+      WHERE user_id=p_user AND used_platform_key AND state='held' AND created_at>=now()-interval '30 days'
+    ) AS consumption;
+    IF total_limit IS NOT NULL AND total_used+p_tokens>total_limit THEN RETURN 'user_tokens'; END IF;
+    IF model_limit IS NOT NULL AND model_used+p_tokens>model_limit THEN RETURN 'model_tokens'; END IF;
+  END IF;
+
+  IF NOT reserve_ai_money(p_id,p_user,p_project,p_run,p_tokens,p_window,p_week,p_amount,p_limits) THEN
+    IF EXISTS (
+      SELECT 1 FROM usage_records u LEFT JOIN usage_reservations r ON r.id=u.reservation_id
+      WHERE u.used_platform_key AND u.created_at>=now()-interval '30 days'
+        AND (u.estimated_cost_toman IS NULL OR r.reserved_toman IS NULL)
+    ) OR EXISTS (
+      SELECT 1 FROM usage_reservations WHERE used_platform_key AND state='held'
+        AND created_at>=now()-interval '30 days' AND reserved_toman IS NULL
+    ) THEN RETURN 'uncertain_usage'; END IF;
+
+    FOR bucket IN SELECT * FROM (VALUES
+      ('platform_day', interval '1 day'), ('platform_month', interval '30 days'),
+      ('user_day', interval '1 day'), ('user_month', interval '30 days'),
+      ('project_day', interval '1 day'), ('project_month', interval '30 days'),
+      ('run', null::interval)
+    ) AS b(scope, period)
+    LOOP
+      SELECT coalesce(sum(reserved_toman),0) INTO used_toman
+      FROM usage_reservations r WHERE r.used_platform_key AND r.state<>'released'
+        AND (bucket.period IS NULL OR r.created_at>=now()-bucket.period)
+        AND CASE
+          WHEN bucket.scope LIKE 'user_%' THEN r.user_id=p_user
+          WHEN bucket.scope LIKE 'project_%' THEN r.project_id=p_project
+          WHEN bucket.scope='run' THEN r.run_id=p_run
+          ELSE true
+        END;
+      IF used_toman + p_amount > (p_limits->>bucket.scope)::bigint THEN RETURN bucket.scope; END IF;
+    END LOOP;
+    RETURN 'plan_tokens';
+  END IF;
+  UPDATE usage_reservations SET requested_model=p_model,task_key=p_task WHERE id=p_id;
+  RETURN 'allowed';
+END;
+$$;
+--> statement-breakpoint
+CREATE FUNCTION delete_owned_project(p_project uuid, p_user uuid) RETURNS text LANGUAGE plpgsql AS $$
+BEGIN
+  PERFORM pg_advisory_xact_lock(19871205);
+  PERFORM id FROM projects WHERE id=p_project AND user_id=p_user FOR UPDATE;
+  IF NOT FOUND THEN RETURN 'missing'; END IF;
+  IF EXISTS (SELECT 1 FROM workflow_runs WHERE project_id=p_project AND status IN ('queued','running')) THEN
+    RETURN 'active';
+  END IF;
+  DELETE FROM projects WHERE id=p_project AND user_id=p_user;
+  RETURN 'deleted';
+END;
+$$;
