diff --git a/src/components/AiQuotaPanel.tsx b/src/components/AiQuotaPanel.tsx
new file mode 100644
index 0000000..5cd5139
--- /dev/null
+++ b/src/components/AiQuotaPanel.tsx
@@ -0,0 +1,116 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import type { quotaSettings } from "@/lib/billing/ai-quotas";
+import { api } from "./api";
+
+type Data = Awaited<ReturnType<typeof quotaSettings>>;
+type Target = { type: "default"; model: string } | { type: "user"; userId: string };
+
+const endpoint = "/api/admin/ai-quotas";
+
+function LimitForm({ limit, label, onSave }: { limit: number | null; label: string; onSave: (limit: number | null) => Promise<void> }) {
+  const [saving, setSaving] = useState(false);
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const value = new FormData(event.currentTarget).get("limit");
+    setSaving(true);
+    try { await onSave(value === "" ? null : Number(value)); }
+    finally { setSaving(false); }
+  }
+  return (
+    <form onSubmit={submit} className="flex flex-wrap items-center gap-2">
+      <input key={limit} aria-label={label} className="input !w-40" name="limit" type="number" dir="ltr"
+        min={0} max={2000000000} step={1} placeholder="بدون سقف افزوده" defaultValue={limit ?? ""} />
+      <button className="btn-secondary btn-sm" disabled={saving} type="submit">ذخیره</button>
+    </form>
+  );
+}
+
+export function AiQuotaPanel({ initial, models }: { initial: Data; models: string[] }) {
+  const [data, setData] = useState(initial);
+  const [search, setSearch] = useState("");
+  const [page, setPage] = useState(0);
+  const [pending, setPending] = useState(false);
+  const [notice, setNotice] = useState("");
+  const modelNames = [...new Set([...models, ...data.defaults.map((row) => row.model)].filter((model) => model !== "*"))];
+  const defaultTotal = data.defaults.find((row) => row.model === "*")?.limit ?? null;
+
+  async function load(query: string, targetPage: number) {
+    const params = new URLSearchParams({ q: query, page: String(targetPage) });
+    setData(await api<Data>(`${endpoint}?${params}`));
+    setPage(targetPage);
+  }
+
+  async function refresh(query: string, targetPage: number) {
+    setPending(true);
+    setNotice("");
+    try { await load(query, targetPage); }
+    catch (error) { setNotice((error as Error).message); }
+    finally { setPending(false); }
+  }
+
+  async function save(target: Target, limit: number | null) {
+    setNotice("");
+    try {
+      await api(endpoint, { method: "PATCH", body: JSON.stringify({ ...target, limit }) });
+      setNotice("سهمیه ذخیره شد.");
+      await load(search, page);
+    } catch (error) { setNotice((error as Error).message); }
+  }
+
+  return (
+    <div className="space-y-4">
+      <section className="panel space-y-3 p-4">
+        <h2 className="font-bold">سقف‌های پیش‌فرض</h2>
+        <p className="text-sm text-muted">مبنای همهٔ سقف‌ها تعداد توکن کلید مرکزی در ۳۰ روز شناور است. سقف هر مدل برای هر کاربر اعمال می‌شود. صفر یعنی توقف مصرف و فیلد خالی یعنی برداشتن این سقف افزوده. حساب توسعه‌دهنده از این سهمیه‌ها معاف است.</p>
+        <div className="flex flex-wrap items-center gap-3">
+          <span>سهمیهٔ کل پیش‌فرض</span>
+          <LimitForm label="سهمیهٔ کل پیش‌فرض" limit={defaultTotal} onSave={(limit) => save({ type: "default", model: "*" }, limit)} />
+        </div>
+        {modelNames.map((model) => (
+          <div key={model} className="flex flex-wrap items-center gap-3">
+            <span dir="ltr">{model}</span>
+            <LimitForm label={`سقف ${model}`} limit={data.defaults.find((row) => row.model === model)?.limit ?? null}
+              onSave={(limit) => save({ type: "default", model }, limit)} />
+          </div>
+        ))}
+        <form className="flex flex-wrap items-center gap-2" onSubmit={(event) => {
+          event.preventDefault();
+          const input = new FormData(event.currentTarget);
+          void save({ type: "default", model: String(input.get("model")) }, Number(input.get("limit")));
+        }}>
+          <input className="input !w-52" name="model" aria-label="شناسه مدل جدید" placeholder="Gemini-2.5-Pro" dir="ltr" maxLength={150} required />
+          <input className="input !w-36" name="limit" aria-label="سقف مدل جدید" type="number" dir="ltr" min={0} max={2000000000} step={1} required />
+          <button className="btn-secondary btn-sm" type="submit">ثبت سقف مدل</button>
+        </form>
+      </section>
+      <section className="panel space-y-3 p-4">
+        <h2 className="font-bold">کاربران و مصرف توکن</h2>
+        <p className="text-sm text-muted">سقف اختصاصی جایگزین سهمیهٔ کل پیش‌فرض می‌شود. برای بازگشت به پیش‌فرض، فیلد را خالی و ذخیره کنید.</p>
+        <form className="flex flex-wrap gap-2" onSubmit={(event) => {
+          event.preventDefault();
+          void refresh(search, 0);
+        }}>
+          <input className="input !w-60" aria-label="جست‌وجوی کاربران" placeholder="نام یا ایمیل" maxLength={100} value={search} onChange={(event) => setSearch(event.target.value)} />
+          <button className="btn-secondary btn-sm" type="submit" disabled={pending}>جست‌وجو</button>
+        </form>
+        {data.users.length === 0 && <p className="text-sm text-muted">کاربری پیدا نشد.</p>}
+        {data.users.map((user) => (
+          <div key={user.id} className="flex flex-wrap items-center justify-between gap-3 border-t border-line py-3">
+            <div className="min-w-0">
+              <p className="break-all text-sm" dir="auto">{user.name ? `${user.name} · ${user.email}` : user.email}</p>
+              <p className="text-xs text-muted">{Number(user.used).toLocaleString("fa-IR")} توکن مصرف و رزرو شده</p>
+            </div>
+            <LimitForm label={`سهمیهٔ اختصاصی ${user.email}`} limit={user.limit} onSave={(limit) => save({ type: "user", userId: user.id }, limit)} />
+          </div>
+        ))}
+        <div className="flex gap-2">
+          {page > 0 && <button className="btn-secondary btn-sm" disabled={pending} onClick={() => void refresh(search, page - 1)}>قبلی</button>}
+          {data.more && <button className="btn-secondary btn-sm" disabled={pending} onClick={() => void refresh(search, page + 1)}>بعدی</button>}
+        </div>
+      </section>
+      <p role="status" className="text-sm">{notice}</p>
+    </div>
+  );
+}
