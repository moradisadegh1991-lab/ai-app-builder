@@ -0,0 +1,61 @@
+import type { ArvanModel } from "@/lib/ai/arvan-catalog";
+
+type Rates = Pick<ArvanModel, "inputTomanPerMillion" | "outputTomanPerMillion">;
+export type ArvanReferenceModel = Rates & { name: string };
+export type ArvanModelOption = {
+  key: string;
+  id: string | null;
+  label: string;
+  rates: Rates | null;
+  responseId: string | null;
+  enabled: boolean;
+};
+export const priceGroups = [
+  { key: "economy", label: "اقتصادی", limit: 1_000_000 },
+  { key: "mid", label: "میان‌رده", limit: 4_000_000 },
+  { key: "premium", label: "گران‌تر", limit: Infinity },
+  { key: "unknown", label: "بدون تعرفهٔ ثبت‌شده", limit: Infinity },
+] as const;
+
+export function groupArvanOptions<T extends { label: string; rates: Rates | null }>(options: readonly T[]) {
+  const total = (item: T) => item.rates
+    ? item.rates.inputTomanPerMillion + item.rates.outputTomanPerMillion : Infinity;
+  return priceGroups.map(({ key, label, limit }, index) => ({
+    key, label,
+    items: options.filter((item) => item.rates
+      ? key !== "unknown" && total(item) <= limit && (index === 0 || total(item) > priceGroups[index - 1]!.limit)
+      : key === "unknown")
+      .sort((a, b) => total(a) - total(b) || a.label.localeCompare(b.label)),
+  })).filter(({ items }) => items.length > 0);
+}
+
+const normalized = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, "");
+
+export function catalogOptions(models: readonly ArvanModel[], discovered: readonly string[], reference: readonly ArvanReferenceModel[]) {
+  const registered = new Map(models.map((model) => [model.id, model]));
+  return [...new Set([...registered.keys(), ...discovered])].map((id): ArvanModelOption => {
+    const saved = registered.get(id);
+    const matched = reference.filter(({ name }) => normalized(name) === normalized(id.split("/").at(-1) ?? id));
+    const preset = matched.length === 1 ? matched[0] : undefined;
+    return {
+      key: `id:${id}`, id, label: saved?.label ?? preset?.name ?? id, rates: saved ?? preset ?? null,
+      responseId: saved?.responseId ?? null, enabled: saved?.enabled ?? false,
+    };
+  });
+}
+
+export function referenceOption(reference: ArvanReferenceModel, options: readonly ArvanModelOption[]): ArvanModelOption {
+  const matched = options.filter(({ id, label }) => id && [id.split("/").at(-1) ?? id, label]
+    .some((value) => normalized(value) === normalized(reference.name)));
+  if (matched.length === 1) return matched[0]!;
+  return { key: `ref:${reference.name}`, id: null, label: reference.name, rates: reference, responseId: null, enabled: false };
+}
+
+export function modelDraft(option?: ArvanModelOption) {
+  return {
+    id: option?.id ?? "", label: option?.label ?? "", responseId: option?.responseId ?? "",
+    input: option?.rates ? String(option.rates.inputTomanPerMillion) : "",
+    output: option?.rates ? String(option.rates.outputTomanPerMillion) : "",
+    enabled: option?.enabled ?? false,
+  };
+}
