diff --git a/src/lib/agents/verification-failure.ts b/src/lib/agents/verification-failure.ts
new file mode 100644
index 0000000..ad3b1b4
--- /dev/null
+++ b/src/lib/agents/verification-failure.ts
@@ -0,0 +1,41 @@
+export const verificationFailures = {
+  docker_access: { detail: "سرویس بررسی به محیط اجرای آزمایشی دسترسی ندارد.", retry: false },
+  image_missing: { detail: "یکی از ابزارهای لازم برای محیط آزمایشی روی سرور آماده نیست.", retry: false },
+  packages_unavailable: { detail: "دریافت بسته‌های لازم برای بررسی پروژه موقتاً قطع شده است.", retry: true },
+  package_missing: { detail: "یکی از بسته‌های لازم در منبع بسته‌های پلتفرم در دسترس نیست.", retry: false },
+  package_install: { detail: "پلتفرم نتوانست بسته‌های لازم برای بررسی پروژه را آماده کند.", retry: false },
+  capacity: { detail: "محیط آزمایشی با کمبود منابع روبه‌رو شد.", retry: true },
+  preview_database: { detail: "دیتابیس موقت بررسی آماده نشد.", retry: true },
+  browser: { detail: "مرورگر آزمایشی نتوانست بررسی پروژه را آغاز کند.", retry: true },
+  runner_unavailable: { detail: "محیط اجرای آزمایشی موقتاً پاسخ نداد.", retry: true },
+  unknown: { detail: "پلتفرم نتوانست بررسی فنی را اجرا کند.", retry: false },
+} as const;
+
+export type VerificationBlocker = keyof typeof verificationFailures;
+export type VerificationStage = "runner" | "image" | "install" | "database" | "browser";
+
+export function classifyVerificationBlocker(log: string, stage?: VerificationStage): VerificationBlocker {
+  if (/permission denied.*docker|docker.*permission denied|docker daemon socket|spawn docker ENOENT|docker:.*not found/i.test(log)) return "docker_access";
+  if (/no such image|image.*(?:missing|not found)|تصویر .*نصب نیست|manifest unknown|pre-pull postgres/i.test(log)) return "image_missing";
+  if (/no space left|out of memory|cannot allocate memory|exited with code 137/i.test(log)) return "capacity";
+  if (/cannot connect to the docker daemon|docker daemon.*not running|error during connect|Cannot create isolated Docker network/i.test(log)) return "runner_unavailable";
+  if (stage === "install" || /dependency installation failed/i.test(log)) {
+    if (/ETARGET|E404|no matching version|404 not found/i.test(log)) return "package_missing";
+    if (/EAI_AGAIN|ECONNRESET|ECONNREFUSED|ENOTFOUND|ETIMEDOUT|E(?:5\d\d|429)|5\d\d (?:bad gateway|service unavailable|gateway timeout)|command timed out/i.test(log)) return "packages_unavailable";
+    return "package_install";
+  }
+  if (stage === "database" || /sandbox (?:postgresql|database)/i.test(log)) return "preview_database";
+  if (stage === "browser" || /browser runner failed|cannot start sandbox app/i.test(log)) return "browser";
+  if (stage === "runner" || /command timed out/i.test(log)) return "runner_unavailable";
+  return "unknown";
+}
+
+export function verificationMessage(blocker: VerificationBlocker) {
+  return `${verificationFailures[blocker].detail} مراحل انجام‌شده ذخیره شده‌اند. اگر مشکل ادامه داشت، شناسهٔ اجرا را به پشتیبانی پلتفرم بدهید.`;
+}
+
+export class VerificationBlockedError extends Error {
+  constructor(public readonly blocker: VerificationBlocker) {
+    super(verificationMessage(blocker));
+  }
+}
