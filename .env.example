# ---------- Platform database (Neon PostgreSQL) ----------
# Pooled connection string of the Neon database that stores the platform's own data.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/idea2app?sslmode=require

# ---------- Public URL of this platform ----------
# Used to build the GitHub OAuth callback URL. No trailing slash.
APP_URL=http://localhost:3000

# ---------- Security ----------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# At least 32 random characters. Generate the same way as above.
SESSION_SECRET=

# ---------- GitHub OAuth App (login + repo/workflow access) ----------
# Create at https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Central AI keys (optional; users can also bring their own key) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model overrides (optional)
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-pro

# Daily AI request limit per user when the platform's central keys are used.
AI_DAILY_REQUEST_LIMIT=20

# ---------- Optional platform-wide Neon key ----------
# If set, users without their own Neon key get databases created under this account.
NEON_API_KEY=
NEON_ORG_ID=
