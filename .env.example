# ---------- Platform database (PostgreSQL) ----------
# Neon (recommended on Vercel; uses Neon's HTTP driver) or any PostgreSQL (e.g. on your VPS).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/idea2app?sslmode=require

# ---------- Public URL of this platform ----------
# Used for OAuth/payment callbacks and the VPS agent install command. No trailing slash.
APP_URL=http://localhost:3000

# ---------- Security ----------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# At least 32 random characters. Generate the same way as above.
SESSION_SECRET=

# ---------- E-mail (login codes) ----------
# Resend is used when RESEND_API_KEY is set; otherwise SMTP. Without either, codes are
# printed to the server log in development and login fails in production.
MAIL_FROM="Idea2App AI <no-reply@your-domain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- GitHub OAuth App (sign in with GitHub + connect repos/Actions) ----------
# Create at https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Google sign-in (optional; the button shows only when both are set) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Central AI keys (optional; users can also bring their own key) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Bot protection (optional) ----------
# Cloudflare Turnstile on the e-mail code request. dash.cloudflare.com -> Turnstile -> Add widget
# (hostname = your site). Both keys must be set to turn it on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Developer accounts ----------
# Comma-separated e-mails that get the unlimited plan (flagship models, no token or project limits).
UNLIMITED_EMAILS=

# ---------- Optional: one OpenAI-compatible gateway for all three providers ----------
# e.g. Liara AI (console.liara.ir/ai): Base URL looks like https://ai.liara.ir/api/<id>/v1.
# When both are set, central calls for OpenAI, Claude and Gemini go through it (users' own keys still
# go directly to the provider). Put the gateway's model IDs in the *_MODEL variables below, either full
# ("google/gemini-3.7-flash") or bare ("gemini-3.7-flash"; the vendor prefix is added).
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Models for paid plans (optional overrides)
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-pro
# Models for the free plan (optional overrides)
OPENAI_ECONOMY_MODEL=gpt-5-mini
ANTHROPIC_ECONOMY_MODEL=claude-haiku-5-5
GEMINI_ECONOMY_MODEL=gemini-2.5-flash

# ---------- Payments ----------
# Zarinpal (toman, Iranian bank cards). Prices are the plan's USD price × USD_TO_TOMAN.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
USD_TO_TOMAN=
# Stripe (USD, international cards). Webhook endpoint: ${APP_URL}/api/billing/stripe/webhook
# (event: checkout.session.completed). The webhook is a backup; payments are also verified on return.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Optional platform-wide Neon key ----------
# If set, users without their own Neon key get databases created under this account.
NEON_API_KEY=
NEON_ORG_ID=

# ---------- Specialist agent worker ----------
# Vercel automatically starts durable Workflow runs; configure a trusted tool snapshot.
# Prepare with scripts/prepare-vercel-sandbox.ts using Vercel CLI/OIDC credentials.
AGENT_RUNTIME=
VERCEL_AGENT_SNAPSHOT_ID=
CRON_SECRET=
# Self-hosted alternative: start a persistent Docker worker with npm run worker.
WORKFLOW_MAX_TOKENS=250000
AGENT_BUILD_IMAGE=idea2app-build:1
AGENT_SANDBOX_IMAGE=idea2app-sandbox:1
# Optional CA file for npm inside the install container (worker host path).
AGENT_NPM_CA_FILE=
# Empty provider/model values inherit the project's provider and plan's model tier.
AGENT_ARCHITECT_PROVIDER=
AGENT_DESIGNER_PROVIDER=
AGENT_FRONTEND_PROVIDER=
AGENT_BACKEND_PROVIDER=
AGENT_REVIEWER_PROVIDER=
AGENT_DEBUGGER_PROVIDER=
# Examples: AGENT_DESIGNER_MODEL=... and AGENT_DESIGNER_ECONOMY_MODEL=...
