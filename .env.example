# ---------- Platform database (PostgreSQL) ----------
# Neon (recommended on Vercel; uses Neon's HTTP driver) or any PostgreSQL (e.g. on your VPS).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/idea2app?sslmode=require

# ---------- Public URL of this platform ----------
# Used for OAuth/payment callbacks and the VPS agent install command. No trailing slash.
APP_URL=http://localhost:3000

# ---------- Security ----------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# At least 32 random characters. Generate the same way as above.
SESSION_SECRET=

# ---------- E-mail (login codes) ----------
# Resend is used when RESEND_API_KEY is set; otherwise SMTP. Without either, codes are
# printed to the server log in development and login fails in production.
MAIL_FROM="Idea2App AI <no-reply@your-domain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- GitHub OAuth App (connect GitHub: repos + Actions) ----------
# Create at https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Central AI keys (optional; users can also bring their own key) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Models for paid plans (optional overrides)
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-pro
# Models for the free plan (optional overrides)
OPENAI_ECONOMY_MODEL=gpt-5-mini
ANTHROPIC_ECONOMY_MODEL=claude-haiku-5-5
GEMINI_ECONOMY_MODEL=gemini-2.5-flash

# ---------- Payments ----------
# Zarinpal (toman, Iranian bank cards). Prices are the plan's USD price × USD_TO_TOMAN.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
USD_TO_TOMAN=
# Stripe (USD, international cards). Webhook endpoint: ${APP_URL}/api/billing/stripe/webhook
# (event: checkout.session.completed). The webhook is a backup; payments are also verified on return.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Optional platform-wide Neon key ----------
# If set, users without their own Neon key get databases created under this account.
NEON_API_KEY=
NEON_ORG_ID=
